# Audiobook Studio — environment template. Copy to .env and fill in your keys.
# .env is git-ignored: never commit real keys.

# demo: pipeline test with audible tones (no speech); live: real ElevenLabs synthesis
APP_MODE=live
DATA_DIR=./data

# ElevenLabs API key (https://elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=

# Optional Chat Completions-compatible LLM for analysis and direction.
# Cloud example: https://api.openai.com/v1 + gpt-4o
# Local example: http://127.0.0.1:11434/v1 + local model name
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ASR uses ElevenLabs Scribe and may incur provider charges in live mode.
ASR_ENABLED=true
NARRATION_MODEL=eleven_v3
INCLUDE_NARRATOR_IN_DIALOGUE=true
MAX_ATTEMPTS=3
REQUEST_GAP_SECONDS=0.5

# Uses bundled imageio-ffmpeg when unset.
FFMPEG_PATH=
